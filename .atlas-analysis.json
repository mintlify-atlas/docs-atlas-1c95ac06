  "keyFeatures": [
    "Structured, typed span and event fields",
    "Async-aware tracing with first-class async/await support",
    "#[instrument] procedural macro for zero-boilerplate function instrumentation",
    "Composable Layer system for building flexible subscriber pipelines",
    "EnvFilter for runtime log-level filtering via RUST_LOG",
    "Non-blocking file appender for high-throughput logging",
    "Flamegraph generation via tracing-flame",
    "Error enrichment with span context via tracing-error",
    "Compatibility with the log crate via tracing-log",
    "no_std support"
  ],
